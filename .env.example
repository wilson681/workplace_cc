# Copy to .env and fill in to switch the pipeline from MOCK mode to LIVE mode.
# The pipeline runs fully WITHOUT any of these (deterministic mock output).

# --- Text generation (niche research + listings). Without it, mock copy is used. ---
ANTHROPIC_API_KEY=
# Cheap + fast is ideal for bulk listing generation. Options:
#   claude-haiku-4-5-20251001  (default, cheapest)
#   claude-sonnet-4-6          (higher quality copy)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Image / design generation. Without it, a labeled SVG placeholder is used. ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Publishing / fulfillment (Print-on-Demand). Without it, publish is a dry-run. ---
# Get from https://printify.com/app/account/api  (free account).
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Where generated catalogs are written.
OUT_DIR=output
